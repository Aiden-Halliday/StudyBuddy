@model IEnumerable<StudyBuddy.ViewModels.Search.SearchViewModel>
@{
    ViewData["Title"] = "Search";
}

<h1>@ViewData["Title"]</h1>

<div class="container mt-4">
    <ol class="list-group list-group-numbered">
        @foreach (var user in Model)
        {
            <li class="list-group-item p-3">
                Display Name: @user.DisplayName
                Compatibility Score: @user.Score
                Strengths:
                @foreach (var userSkills in user.Skills)
                {
                    if (userSkills.Type == SkillType.Strength)
                    {
                        <span class="me-1">@userSkills.Skill.Name</span>
                    }
                }
                Weaknesses:
                @foreach (var userSkills in user.Skills)
                {
                    if (userSkills.Type == SkillType.Weakness)
                    {
                        <span class="me-1">@userSkills.Skill.Name</span>
                    }
                }
            </li>
        }
    </ol>
</div>