@model IEnumerable<StudyBuddy.ViewModels.Search.SearchViewModel>
@using StudyBuddy.Models

@{
    ViewData["Title"] = "Search";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @TempData["Success"]
        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div class="container mt-4">

    <div class="mb-4">
        <h2 class="mb-1">Find Study Partners</h2>

        <p class="text-muted mb-0">
            Discover students by skills and helpfulness ratings,
            or search for a specific student.
        </p>
    </div>

    <div class="mb-4">
        <h3>Search for a student</h3>
        <partial name="_SearchBar" />
    </div>

    <h3>
        @(ViewData["Query"] != null ? "Results" : "All students")
    </h3>

    <p class="text-muted small">
        Rated students are ordered by helpfulness percentage,
        then compatibility. Unrated students appear last.
    </p>

    @if (Model.Any())
    {
        <div class="row g-4">

            @foreach (var user in Model)
            {
                <div class="col-12 col-md-6">
                    <div class="card shadow-sm h-100">
                        <div class="card-body p-4">

                            <!-- Student heading -->
                            <div class="d-flex justify-content-between align-items-start mb-3">

                                <div>
                                    <a asp-controller="Profile"
                                       asp-action="DedicatedProfile"
                                       asp-route-id="@user.UserId"
                                       class="profileLink">

                                        <h4 class="card-title mb-1">
                                            @user.DisplayName
                                        </h4>
                                    </a>

                                    <!-- Reputation display -->
                                    @if (user.TotalVotes > 0)
                                    {
                                        <p class="small text-success fw-semibold mb-1">
                                            @(user.HelpfulPercentage?.ToString("0"))%
                                            found this student helpful
                                        </p>

                                        <small class="text-muted">
                                            @user.TotalVotes rating(s)
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">
                                            No ratings yet
                                        </span>
                                    }
                                </div>

                                <!-- Compatibility score -->
                                <div class="text-center bg-light rounded p-3 ms-2">
                                    <h3 class="text-primary mb-0">
                                        @user.Score%
                                    </h3>

                                    <small class="text-muted">
                                        Compatibility
                                    </small>
                                </div>
                            </div>

                            <!-- Student profile image -->
                            @if (!string.IsNullOrEmpty(user.ProfileImageKey))
                            {
                                <img src="@Url.Action("Image", "Profile", new { userId = user.UserId })"
                                     alt="@user.DisplayName's profile picture"
                                     class="rounded-circle"
                                     style="width: 75px; height: 75px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="rounded-circle bg-light border d-flex align-items-center justify-content-center"
                                     style="width: 75px; height: 75px;">
                                    <i class="bi bi-person fs-3 text-secondary"></i>
                                </div>
                            }

                            <hr />

                            <!-- Student strengths -->
                            <div class="mb-3">
                                <h6 class="fw-semibold text-success mb-2">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    Strengths
                                </h6>

                                @if (user.Skills.Any(s => s.Type == SkillType.Strength))
                                {
                                    <div class="d-flex flex-wrap gap-2">

                                        @foreach (var skill in user.Skills.Where(s => s.Type == SkillType.Strength))
                                        {
                                            <span class="badge bg-success-subtle text-success border border-success-subtle p-2">
                                                @skill.Skill.Name
                                            </span>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        No strengths listed.
                                    </span>
                                }
                            </div>

                            <!-- Student weaknesses -->
                            <div>
                                <h6 class="fw-semibold text-danger mb-2">
                                    <i class="bi bi-exclamation-circle-fill me-1"></i>
                                    Weaknesses
                                </h6>

                                @if (user.Skills.Any(s => s.Type == SkillType.Weakness))
                                {
                                    <div class="d-flex flex-wrap gap-2">

                                        @foreach (var skill in user.Skills.Where(s => s.Type == SkillType.Weakness))
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle p-2">
                                                @skill.Skill.Name
                                            </span>
                                        }

                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        No weaknesses listed.
                                    </span>
                                }
                            </div>

                            <!-- Friend request controls -->
                            @if (user.IsFriend)
                            {
                                <button type="button"
                                        class="btn btn-success w-100 mt-4"
                                        disabled>
                                    <i class="bi bi-check-circle me-1"></i>
                                    Already Friends
                                </button>
                            }
                            else if (user.HasSentRequest)
                            {
                                <form asp-controller="Friend"
                                      asp-action="CancelRequest"
                                      asp-route-id="@user.UserId"
                                      method="post"
                                      class="mt-4">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-outline-danger w-100">
                                        <i class="bi bi-x-circle me-1"></i>
                                        Cancel Request
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-controller="Friend"
                                      asp-action="SendRequest"
                                      asp-route-id="@user.UserId"
                                      method="post"
                                      class="mt-4">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-primary w-100">
                                        <i class="bi bi-person-plus me-1"></i>
                                        Send Friend Request
                                    </button>
                                </form>
                            }

                        </div>
                    </div>
                </div>
            }

        </div>
    }
    else
    {
        <div class="card shadow-sm text-center p-5">
            <h5>No other students found</h5>

            <p class="text-muted mb-0">
                There are currently no students matching your search.
            </p>
        </div>
    }

</div>
