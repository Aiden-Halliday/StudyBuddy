@model StudyBuddy.ViewModels.Profile.ProfileViewModel
@using StudyBuddy.Models
@{
    ViewData["Title"] = "Edit Profile";
}

<h1>@ViewData["Title"]</h1>

<div>
    <table class="table table-striped table-hover sortable">
        <thead>
            <tr>
                <th>Skill</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        @foreach (var skill in Model.AvailableSkills)
        {
            var alreadyAdded = Model.Skills.Any(us => us.SkillId == skill.SkillId);

            <tr>
                <td>@skill.Name</td>
                <td>
                    @if (!alreadyAdded)
                    {
                        <div class="d-flex gap-2">
                            <form asp-controller="Profile" asp-action="AddSkill" method="post"> 
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="SelectedSkillId" value="@skill.SkillId" />

                                <input type="hidden" name="Type" value="@SkillType.Strength" />

                                <button type="submit" class="btn btn-success btn-sm">Strength</button>
                            </form>

                            <form asp-controller="Profile" asp-action="AddSkill" method="post"> 
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="SelectedSkillId" value="@skill.SkillId" />

                                <input type="hidden" name="Type" value="@SkillType.Weakness" />

                                <button type="submit" class="btn btn-warning btn-sm">Weakness</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Already added</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div>
    <h3>Strengths</h3>
    @foreach (var strength in Model.Skills)
    {
        @if (strength.Type == SkillType.Strength)
        {
            <ul>
                @strength.Skill.Name
                <form asp-controller="Profile" asp-action="RemoveSkill" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userSkillId" value="Strength.UserSkillId" />

                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                </form>
            </ul>
        }
    }
</div>

<div>
    <h3>Weaknesses</h3>
    @foreach (var weakness in Model.Skills)
    {
        @if (weakness.Type == SkillType.Weakness)
        {
            <ul>
                @weakness.Skill.Name
                <form asp-controller="Profile" asp-action="RemoveSkill" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userSkillId" value="Weakness.UserSkillId" />

                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                </form>
            </ul>
        }
    }
</div>