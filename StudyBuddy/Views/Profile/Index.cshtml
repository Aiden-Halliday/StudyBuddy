@model StudyBuddy.ViewModels.Profile.ProfileViewModel
@using StudyBuddy.Models
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted mb-0">Manage your profile and skills.</p>
    </div>

    <a asp-controller="Friend"asp-action="Requests" class="btn btn-primary"> <i class="bi bi-person-plus"></i>Friend Requests</a>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <h5 class="card-title">Profile Picture</h5>

        <div class="d-flex align-items-center gap-4 flex-wrap mb-3">

            @if (!string.IsNullOrEmpty(Model.ProfileImageKey))
            {
                <img src="@Url.Action("Image", "Profile",
                     new { userId = Model.UserId })"
                     alt="Profile Picture"
                     class="rounded-circle border"
                     style="width: 120px; height: 120px; object-fit: cover;" />
            }
            else
            {
                <div class="rounded-circle border bg-light d-flex
                    align-items-center justify-content-center"
                     style="width: 120px; height: 120px;">
                    <span class="text-muted text-center">
                        No picture
                    </span>
                </div>
            }

            <div>
                <p class="text-muted mb-2">
                    Upload a profile picture to personalize your account.
                </p>

                <form asp-controller="Profile"
                      asp-action="UploadProfileImage"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="file"
                           name="profileImage"
                           class="form-control mb-2"
                           accept=".jpg,.jpeg,.png,.webp"
                           required />

                    <button type="submit" class="btn btn-primary">
                        Upload Profile Picture
                    </button>
                </form>

                <small class="text-muted d-block mt-2">
                    Accepted formats: JPG, PNG, WebP. Maximum size: 5 MB.
                </small>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<div>
    <table class="table table-striped table-hover sortable">
        <thead>
            <tr>
                <th>Skill</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>

        @foreach (var skill in Model.AvailableSkills)
        {
            var alreadyAdded = Model.Skills.Any(us => us.SkillId == skill.SkillId);

            <tr>
                <td>@skill.Name</td>
                <td>
                    @if (!alreadyAdded)
                    {
                        <div class="d-flex gap-2">
                            <form asp-controller="Profile" asp-action="AddSkill" method="post"> 
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="SelectedSkillId" value="@skill.SkillId" />

                                <input type="hidden" name="Type" value="@SkillType.Strength" />

                                <button type="submit" class="btn btn-success btn-sm">Strength</button>
                            </form>

                            <form asp-controller="Profile" asp-action="AddSkill" method="post"> 
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="SelectedSkillId" value="@skill.SkillId" />

                                <input type="hidden" name="Type" value="@SkillType.Weakness" />

                                <button type="submit" class="btn btn-warning btn-sm">Weakness</button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">Already added</span>
                    }
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div>
    <h3>Strengths</h3>
    @foreach (var strength in Model.Skills)
    {
        @if (strength.Type == SkillType.Strength)
        {
            <ul>
                @strength.Skill.Name
                <form asp-controller="Profile" asp-action="RemoveSkill" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userSkillId" value="@strength.UserSkillId" />

                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                </form>
            </ul>
        }
    }
</div>

<div>
    <h3>Weaknesses</h3>
    @foreach (var weakness in Model.Skills)
    {
        @if (weakness.Type == SkillType.Weakness)
        {
            <ul>
                @weakness.Skill.Name
                <form asp-controller="Profile" asp-action="RemoveSkill" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="userSkillId" value="@weakness.UserSkillId" />

                    <button type="submit" class="btn btn-danger btn-sm">Remove</button>
                </form>
            </ul>
        }
    }
</div>