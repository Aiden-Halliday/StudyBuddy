@model StudyBuddy.ViewModels.Profile.ProfileViewModel
@using StudyBuddy.Models
@using System.Security.Claims

@{
    ViewData["Title"] = Model.DisplayName + "'s Profile";

    var viewerId = User.FindFirstValue(ClaimTypes.NameIdentifier);

    var canVote = User.Identity?.IsAuthenticated == true &&
                  viewerId != Model.UserId;
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success" role="status">
        @TempData["SuccessMessage"]
    </div>
}

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <div class="d-flex flex-column align-items-center justify-content-center gap-4 mb-3">

            @if (!string.IsNullOrEmpty(Model.ProfileImageKey))
            {
                <img src="@Url.Action("Image", "Profile", new { userId = Model.UserId })"
                     alt="@Model.DisplayName's profile picture"
                     class="rounded-circle border"
                     style="width: 120px; height: 120px; object-fit: cover;" />
            }
            else
            {
                <div class="rounded-circle border bg-light d-flex align-items-center justify-content-center"
                     style="width: 120px; height: 120px;">
                    <span class="text-muted text-center">
                        No picture
                    </span>
                </div>
            }

            <h3 class="mb-0">@Model.DisplayName</h3>

            <!-- Reputation percentage -->
            <div class="text-center">
                @if (Model.TotalVotes > 0)
                {
                    <h4 class="text-success mb-1">
                        @(Model.HelpfulPercentage?.ToString("0"))%
                    </h4>

                    <p class="mb-1">
                        found this student helpful
                    </p>

                    <small class="text-muted">
                        @Model.PositiveVotes positive out of
                        @Model.TotalVotes total votes
                    </small>
                }
                else
                {
                    <p class="text-muted mb-0">
                        No ratings yet
                    </p>
                }
            </div>

            <!-- Strengths -->
            <div class="text-center">
                <h6 class="fw-semibold text-success mb-2">
                    <i class="bi bi-check-circle-fill me-1"></i>
                    Strengths
                </h6>

                @if (Model.Skills.Any(s => s.Type == SkillType.Strength))
                {
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        @foreach (var skill in Model.Skills.Where(s => s.Type == SkillType.Strength))
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle p-2">
                                @skill.Skill.Name
                            </span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted small">
                        No strengths listed.
                    </span>
                }
            </div>

            <!-- Weaknesses -->
            <div class="text-center">
                <h6 class="fw-semibold text-danger mb-2">
                    <i class="bi bi-exclamation-circle-fill me-1"></i>
                    Weaknesses
                </h6>

                @if (Model.Skills.Any(s => s.Type == SkillType.Weakness))
                {
                    <div class="d-flex flex-wrap justify-content-center gap-2">
                        @foreach (var skill in Model.Skills.Where(s => s.Type == SkillType.Weakness))
                        {
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle p-2">
                                @skill.Skill.Name
                            </span>
                        }
                    </div>
                }
                else
                {
                    <span class="text-muted small">
                        No weaknesses listed.
                    </span>
                }
            </div>

            <!-- Student voting -->
            @if (canVote)
            {
                <section class="text-center border-top pt-4 w-100"
                         aria-label="Rate student">

                    <h5>Studied with this student before?</h5>

                    <p class="text-muted">
                        Rate your experience with them.
                    </p>

                    @if (Model.CurrentUserVote.HasValue)
                    {
                        <p class="small text-muted">
                            Your current vote:
                            <strong>
                                @(Model.CurrentUserVote.Value
                                    ? "Helpful"
                                    : "Not helpful")
                            </strong>.
                            You can change it below.
                        </p>
                    }

                    <div class="d-flex justify-content-center gap-2 flex-wrap">

                        <!-- Positive vote -->
                        <form asp-controller="Reputation"
                              asp-action="Vote"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="userId"
                                   value="@Model.UserId" />

                            <input type="hidden"
                                   name="isPositive"
                                   value="true" />

                            <button type="submit"
                                    class="btn @(Model.CurrentUserVote == true ? "btn-success" : "btn-outline-success")">

                                <i class="bi bi-hand-thumbs-up me-1"></i>
                                Helpful
                            </button>
                        </form>

                        <!-- Negative vote -->
                        <form asp-controller="Reputation"
                              asp-action="Vote"
                              method="post">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="userId"
                                   value="@Model.UserId" />

                            <input type="hidden"
                                   name="isPositive"
                                   value="false" />

                            <button type="submit"
                                    class="btn @(Model.CurrentUserVote == false ? "btn-danger" : "btn-outline-danger")">

                                <i class="bi bi-hand-thumbs-down me-1"></i>
                                Not helpful
                            </button>
                        </form>

                    </div>
                </section>
            }
        </div>
    </div>
</div>
