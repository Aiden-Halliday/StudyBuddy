@model StudyBuddy.ViewModels.ChatGroup.ChatGroupIndexViewModel

@{
    ViewData["Title"] = "My Chat Groups";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>My Chat Groups</h1>
            <p class="text-muted">View and manage your study groups.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i>
            Create Group
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Groups.Any())
    {
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-people fs-1 text-muted"></i>
                <h4 class="mt-3">No chat groups yet</h4>
                <p class="text-muted">
                    Create a group to start studying with friends.
                </p>

                <a asp-action="Create" class="btn btn-primary">
                    Create Your First Group
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model.Groups)
            {
                var group = item.Group;

                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="bi bi-people me-2"></i>
                                @group.Name
                            </h5>

                            <p class="text-muted">
                                @group.Members.Count member(s)
                            </p>

                            <p class="small text-muted">
                                Created @group.CreatedUtc.ToLocalTime().ToString("MMM dd, yyyy")
                            </p>

                            @await Html.PartialAsync("_InviteFriends", item)

                            <a asp-action="Details"
                               asp-route-id="@group.ChatGroupId"
                               class="btn btn-primary btn-sm">
                                <i class="bi bi-chat-dots me-1"></i>
                                Open Chat
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>