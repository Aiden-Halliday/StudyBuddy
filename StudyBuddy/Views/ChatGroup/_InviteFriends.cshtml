@model StudyBuddy.ViewModels.ChatGroup.ChatGroupIndexItemViewModel

@if (Model.IsCreator)
{
    <div class="mt-3">
        <h6>Invite Friends</h6>

        @if (!Model.AvailableFriends.Any())
        {
            <p class="text-muted small mb-0">
                No friends available to invite.
            </p>
        }
        else
        {
            <div class="list-group">
                @foreach (var friend in Model.AvailableFriends)
                {
                    <div class="list-group-item d-flex justify-content-between align-items-center">
                        <span>@friend.DisplayName</span>

                        <form asp-action="AddMember" method="post">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="groupId"
                                   value="@Model.Group.ChatGroupId" />

                            <input type="hidden"
                                   name="userId"
                                   value="@friend.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-primary">
                                <i class="bi bi-person-plus me-1"></i>
                                Invite
                            </button>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
}