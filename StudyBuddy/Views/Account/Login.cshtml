@model StudyBuddy.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<h1>@ViewData["Title"]</h1>

<form id="loginForm" method="post">
    <h2>Login to your account</h2>
    <div>
        <input asp-for="Email" autocomplete="username" aria-required="true" placeholder="name@example.com" />
        <label asp-for="Email">Email</label>
    </div>
    <div>
        <input asp-for="Password" autocomplete="password" aria-required="true" />
        <label asp-for="Password">Password</label>
    </div>
    <button id="loginSubmit" type="submit">Login</button>
</form>