@model IEnumerable<StudyBuddy.ViewModels.Admin.AdminSkillViewModel>

@{
    ViewData["Title"] = "Skill Management";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">Skill Management</h2>
            <p class="text-muted mb-0"> Manage the preset skills available to users. </p>
        </div>

        <a asp-controller="Admin" asp-action="CreateSkill" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Create Skill
        </a>
    </div>

    @if (Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white py-3">
                <h5 class="mb-0">Available Skills</h5>
            </div>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">Name</th>
                            <th>Description</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold ps-3">
                                    @item.Name
                                </td>
                                <td>
                                    <span class="@(string.IsNullOrWhiteSpace(item.Description) ? "text-muted fst-italic" : "")">
                                        @(string.IsNullOrWhiteSpace(item.Description) ? "No description provided" : item.Description)
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm text-center p-5">
            <div class="card-body">
                <h5 class="mb-2">No preset skills yet</h5>
                <p class="text-muted mb-4"> Create your first skill to make it available to users.</p>
                <a asp-controller="Admin" asp-action="CreateSkill" class="btn btn-primary">
                    <i class="bi bi-plus-lg"></i> Create First Skill
                </a>
            </div>
        </div>
    }
</div>