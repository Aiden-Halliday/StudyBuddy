@model IEnumerable<StudyBuddy.ViewModels.Admin.AdminUserDisplayViewModel>

<h1>User Accounts</h1>
<table class="table table-striped table-hover sortable">
    <thead>
        <tr>
            <th>Id</th>
            <th>DisplayName</th>
            <th>Email</th>
            <th>Account Creation Date</th>
        </tr>
    </thead>
    @foreach (var user in Model)
    {
        <tr>
            <td>
                @user.Id
            </td>
            <td>
                @user.DisplayName
            </td>
            <td>
                @user.Email
            </td>
            <td>
                @user.CreatedUtc
            </td>
        </tr>
    }
</table>
