@model IEnumerable<StudyBuddy.ViewModels.Admin.AdminUserDisplayViewModel>

@{
    ViewData["Title"] = "User Accounts";
    var currentUserId = ViewData["CurrentUserId"] as string;
}

<div class="container mt-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 class="h2 mb-1">User Accounts</h1>
            <p class="text-muted mb-0">
                Manage account access and administrator roles.
            </p>
        </div>

        <a asp-action="Skills" class="btn btn-outline-primary">
            Manage skills
        </a>
    </div>

    @if (TempData["Success"] is string success)
    {
        <div class="alert alert-success" role="status">@success</div>
    }

    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-danger" role="alert">@error</div>
    }

    <form method="get" asp-action="Index" class="d-flex gap-2 mb-3">
        <label for="user-search" class="visually-hidden">
            Search accounts
        </label>

        <input id="user-search"
               name="search"
               value="@ViewData["Search"]"
               class="form-control"
               placeholder="Search by display name or email" />

        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </form>

    <div class="card shadow-sm table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <caption class="px-3">
                @Model.Count() account(s).
                Your own account cannot be changed here.
            </caption>

            <thead class="table-dark">
                <tr>
                    <th scope="col">Name / Email</th>
                    <th scope="col">Role</th>
                    <th scope="col">Status</th>
                    <th scope="col">Created (UTC)</th>
                    <th scope="col">Actions</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var user in Model)
                {
                    <tr>
                        <td>
                            <strong>@user.DisplayName</strong>
                            <br />
                            <span class="text-muted">@user.Email</span>
                        </td>

                        <td>
                            <span class="badge @(user.IsAdmin ? "bg-primary" : "bg-secondary")">
                                @(user.IsAdmin ? "Admin" : "User")
                            </span>
                        </td>

                        <td>
                            <span class="badge @(user.IsLockedOut ? "bg-danger" : "bg-success")">
                                @(user.IsDisabled
                                    ? "Disabled"
                                    : user.IsLockedOut
                                        ? "Temporarily locked"
                                        : "Active")
                            </span>
                        </td>

                        <td>@user.CreatedUtc.ToString("MMM dd, yyyy")</td>

                        <td>
                            @if (user.Id == currentUserId)
                            {
                                <span class="text-muted">Your account</span>
                            }
                            else
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @if (user.IsLockedOut)
                                    {
                                        <form asp-action="Enable" method="post">
                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button class="btn btn-sm btn-outline-success"
                                                    type="submit">
                                                @(user.IsDisabled ? "Enable" : "Unlock")
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Disable"
                                              method="post"
                                              onsubmit="return confirm('Disable this account and end its sessions?');">
                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button class="btn btn-sm btn-outline-warning"
                                                    type="submit">
                                                Disable
                                            </button>
                                        </form>
                                    }

                                    @if (user.IsAdmin)
                                    {
                                        <form asp-action="RemoveAdmin"
                                              method="post"
                                              onsubmit="return confirm('Remove administrator access from this account?');">
                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button class="btn btn-sm btn-outline-secondary"
                                                    type="submit">
                                                Remove admin
                                            </button>
                                        </form>
                                    }
                                    else if (!user.IsLockedOut)
                                    {
                                        <form asp-action="GrantAdmin"
                                              method="post"
                                              onsubmit="return confirm('Give this account full administrator access?');">
                                            <input type="hidden"
                                                   name="id"
                                                   value="@user.Id" />

                                            <button class="btn btn-sm btn-outline-primary"
                                                    type="submit">
                                                Make admin
                                            </button>
                                        </form>
                                    }

                                    <a asp-action="Delete"
                                       asp-route-id="@user.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </div>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">
                            No matching accounts found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>