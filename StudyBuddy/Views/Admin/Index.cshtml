@model IEnumerable<StudyBuddy.ViewModels.Admin.AdminUserDisplayViewModel>

@{
    ViewData["Title"] = "User Accounts";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white py-3">
            <h2 class="mb-0">User Accounts</h2>
        </div>

        <div class="card-body">
            <p class="text-muted mb-4">
                View and manage registered StudyBuddy accounts.
            </p>

            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Id</th>
                            <th>Display Name</th>
                            <th>Email</th>
                            <th>Account Creation Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td class="text-muted">@user.Id</td>
                                <td class="fw-semibold">@user.DisplayName</td>
                                <td>@user.Email</td>
                                <td>@user.CreatedUtc.ToString("MMM dd, yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
